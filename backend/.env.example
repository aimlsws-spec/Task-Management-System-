# Copy to .env (never commit .env). MySQL 8 is the ONLY supported database.
TMS_ENV=dev
TMS_DATABASE_URL=mysql+pymysql://tms_user:CHANGE_ME@localhost:3306/tms?charset=utf8mb4
# Separate database used ONLY by the test suite. Its name must end with _test (tables are truncated).
TMS_TEST_DATABASE_URL=mysql+pymysql://tms_user:CHANGE_ME@localhost:3306/tms_test?charset=utf8mb4
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
TMS_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
TMS_COMPANY_TIMEZONE=Asia/Kolkata
TMS_EOD_TIME=18:30
TMS_CORS_ORIGINS=http://localhost:5173
TMS_COOKIE_SECURE=false

# DEV ONLY: per-tab sessions so several roles can be logged in at once (ignored unless TMS_ENV=dev)
TMS_DEV_MULTI_SESSION=true

# --- Background jobs and email (Phase 6)
# The API never runs jobs itself. Reminders, notifications and email are processed by the cPanel cron job (every minute):
#   /home/USERNAME/virtualenv/DOMAIN/3.12/bin/python /home/USERNAME/DOMAIN/app/jobs/run_once.py >> /home/USERNAME/DOMAIN/logs/cron.log 2>&1
# Locally: python -m app.jobs.run_once --duration 3600 --interval 5   (keeps processing every 5 s while you develop)
TMS_INLINE_JOBS=false   # ignored, kept so old .env files stay valid
# 'log' writes emails to the server log (default, safe). 'smtp' really sends them:
TMS_EMAIL_BACKEND=log
# TMS_EMAIL_BACKEND=smtp
# TMS_SMTP_HOST=smtp.yourprovider.com
# TMS_SMTP_PORT=587
# TMS_SMTP_SECURITY=starttls        # starttls | ssl | none
# TMS_SMTP_USER=
# TMS_SMTP_PASSWORD=
# TMS_EMAIL_FROM=SeaWind Tasks <no-reply@yourcompany.com>
# Public address of the site (no trailing slash); every link in every email is built from it:
# TMS_APP_BASE_URL=https://tasks.yourcompany.com
# cPanel only: the folder that holds the compiled website (index.html), so refreshing /tasks/5 works. Leave empty if the
# web server already does that.
# TMS_FRONTEND_DIR=/home/USERNAME/public_html

# Process notifications and email right after each change (ADR 007). Keep the cron job too (reminders, retries).
TMS_MAIL_AFTER_REQUEST=false

# Every sign-in/sign-up needs a 6-digit code emailed to the person (ADR 008). Needs working SMTP settings above.
# Set to false ONLY as an emergency if mail is down and nobody can sign in.
TMS_OTP_ENABLED=true

# A database that is behind this version upgrades itself on first use (additive migrations). false = run alembic upgrade head by hand.
TMS_AUTO_MIGRATE=true
